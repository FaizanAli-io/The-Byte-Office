# Signs the finance session cookie and magic-link tokens.
# Generate one with: openssl rand -hex 32
FINANCE_SESSION_SECRET=

# Database Configuration
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# LLM API Keys
GROQ_API_KEY=

# Email Configuration (SMTP)
SMTP_USER=
SMTP_PASS=

# Signs OAuth access tokens for the MCP server. Kept separate from the
# session secret so rotating it revokes every MCP token without signing you
# out of the site. Without it, /api/mcp refuses every request.
# Generate one with: openssl rand -hex 32
OAUTH_SIGNING_SECRET=
