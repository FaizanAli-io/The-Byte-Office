# Signs the finance session cookie and magic-link tokens.
# Generate one with: openssl rand -hex 32
FINANCE_SESSION_SECRET=

# Database Configuration
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# LLM API Keys
GROQ_API_KEY=

# Bearer token for the MCP server and the REST tool wrappers at
# /api/mcp and /api/mcp/tools/*. Without it those endpoints return 401 for
# every request. Generate one with: openssl rand -hex 32
MCP_API_KEY=

# Email Configuration (SMTP)
SMTP_USER=
SMTP_PASS=
